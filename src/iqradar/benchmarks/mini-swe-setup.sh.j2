#!/bin/bash

apt-get update
apt-get install -y python3 python3-pip

# Ubuntu 24.04+ (PEP 668) rejects plain pip installs into the system env;
# fall back to --break-system-packages when the first attempt is refused.
pip3 install --upgrade pip 2>/dev/null || \
  pip3 install --upgrade --break-system-packages pip

{% if version %}
pip3 install "mini-swe-agent=={{ version }}" 2>/dev/null || \
  pip3 install --break-system-packages "mini-swe-agent=={{ version }}"
{% else %}
pip3 install mini-swe-agent 2>/dev/null || \
  pip3 install --break-system-packages mini-swe-agent
{% endif %}

command -v mini >/dev/null 2>&1 && echo "INSTALL_SUCCESS" || echo "INSTALL_FAILED: mini not on PATH"